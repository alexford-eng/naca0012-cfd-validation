FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 3.5074e-08;

boundaryField
{
    farfield
    {
        type            calculated;
        value           $internalField;
    }
    outlet
    {
        type            calculated;
        value           $internalField;
    }
    aerofoil
    {
        type            nutLowReWallFunction;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}
